pkgname=onevr-git
pkgver=r0
pkgrel=1
pkgdesc="VR on Linux in one app: streaming to standalone headsets, OpenVR games without SteamVR and desktop in VR"
arch=(x86_64)
url="https://github.com/360900/oneVR"
# WiVRn, xrizer and onevr; wayvr and the oneVR window; Monado
license=(GPL-3.0-or-later GPL-3.0-only BSL-1.0)
depends=(
  # WiVRn server
  avahi boost-libs cairo ffmpeg glib2 glibc libarchive libbsd libgcc libgl libnotify libpipewire libpng
  librsvg libstdc++ libx11 libxcb openssl systemd-libs vulkan-icd-loader x264
  # onevr: icon, and pkexec for `onevr doctor --fix`
  hicolor-icon-theme polkit
  # wayvr, and the oneVR window
  alsa-lib dav1d dbus libinput libxcursor libxext libxi libxkbcommon libxkbcommon-x11 libxrandr openvr
  openxr wayland xwayland-satellite
  # 32-bit xrizer
  lib32-gcc-libs lib32-glibc
)
makedepends=(
  boost clang cli11 cmake eigen git glib2-devel libdrm ninja nlohmann-json python rustup shaderc
  vulkan-headers
)
optdepends=(
  'android-tools: onevr usb and onevr install'
  'wl-clipboard: copying text on Wayland'
  'xclip: copying text on X11'
)
provides=(onevr)
conflicts=(onevr)
# LTO objects in the static OpenXR loader break the Rust link.
options=(!lto !debug)
source=("onevr::git+https://github.com/360900/oneVR.git")
sha256sums=(SKIP)

pkgver() {
  cd onevr
  if git describe --tags --match 'v[0-9]*' >/dev/null 2>&1; then
    git describe --long --tags --match 'v[0-9]*' | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

build() {
  cd onevr
  cargo xtask build --release --i686 --prefix /opt/onevr
}

package() {
  cd onevr
  cargo xtask install --destdir "$pkgdir"
  install -d "$pkgdir/usr/bin" "$pkgdir/usr/share/applications"
  ln -s /opt/onevr/bin/onevr "$pkgdir/usr/bin/onevr"
  ln -s /opt/onevr/share/applications/io.github.onevr.desktop "$pkgdir/usr/share/applications/io.github.onevr.desktop"
  ln -s /opt/onevr/share/applications/io.github.onevr.wayvr.desktop "$pkgdir/usr/share/applications/io.github.onevr.wayvr.desktop"
}
