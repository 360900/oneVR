<layout version="2">
  <!-- oneVR: PC side of oneVR, see src/tab/onevr/pc.rs -->
  <macro name="tab_style" round="10" />
  <elements>
    <div gap="4" width="100%">
      <!-- the same min_width as headset.xml, so the content starts at the same place on both pages -->
      <Tabs id="tabs" min_width="150">
        <Tab macro="tab_style" name="performance" translation="ONEVR.PC.PERFORMANCE" sprite_src_builtin="@/dashboard/barchart.svg" />
        <Tab macro="tab_style" name="headsets" translation="ONEVR.PC.PAIRING" sprite_src_builtin="@/dashboard/wivrn_head_symbolic.svg" />
        <Tab macro="tab_style" name="server" translation="ONEVR.PC.SERVER" sprite_src_builtin="@/dashboard/cpu.svg" />
        <Tab macro="tab_style" name="diagnostics" translation="ONEVR.PC.DIAGNOSTICS" sprite_src_builtin="@/dashboard/diagnostics.svg" />
        <Tab macro="tab_style" name="about" translation="ONEVR.PC.ABOUT" sprite_src_builtin="@/dashboard/info.svg" />
      </Tabs>
      <div id="content" flex_direction="column" gap="8" flex_grow="1">
        <!-- filled in at runtime -->
      </div>
    </div>
  </elements>
</layout>
