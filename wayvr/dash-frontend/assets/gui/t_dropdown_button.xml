<layout version="2">
  <macro name="dropdown_button"
    flex_direction="row"
    border="0"
    color="fill"
    border_color="stroke"
    justify_content="space_between" />

  <!-- id, text, translation, tooltip, min_width -->
  <template name="DropdownButton">
    <label text="${text}" translation="${translation}" />
    <Button id="${id}" height="36" tooltip="${tooltip}" >
      <div padding_left="8" padding_right="8" min_width="${min_width}">
        <label id="${id}_value" weight="semibold" />
      </div>
      <div padding_right="10" align_items="center">
        <sprite width="16" height="16" src_builtin="@/dashboard/down.svg" color="text2" />
      </div>
    </Button>
  </template>

</layout>
