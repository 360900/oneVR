<layout version="2">
  <vars>
    <var key="side_size" value="60" />
    <var key="top_size" value="50" />
    <var key="side_sprite_size" value="20" />
    <var key="side_button_size" value="44" />
  </vars>

  <blueprint name="context_menu_power_options">
    <context_menu>
      <!-- LVRR: restarts only the desktop, upstream's string would say "Restart LVRR" -->
      <cell translation="LVRR.RESTART_DESKTOP" action="restart" sprite_src_builtin="@/dashboard/refresh.svg"/>
      <!-- LVRR: closing the dashboard would leave no UI, the headset can disconnect instead -->
      <cell translation="LVRR.RESTART_SESSION" action="lvrr_restart_session" sprite_src_builtin="@/dashboard/refresh.svg"/>
      <cell translation="LVRR.DISCONNECT" action="lvrr_disconnect" sprite_src_builtin="@/dashboard/close.svg"/>
      <cell translation="LVRR.QUIT" action="lvrr_quit" sprite_src_builtin="@/dashboard/power.svg"/>
      <separator/>
      <cell translation="POWER_OPTIONS.SUSPEND" action="suspend" sprite_src_builtin="@/dashboard/sleep.svg"/>
      <cell translation="POWER_OPTIONS.SHUTDOWN" action="shutdown" sprite_src_builtin="@/dashboard/power.svg"/>
    </context_menu>
  </blueprint>

  <template name="SideButton">
    <Button
      id="${id}"
      round="10"
      width="~side_button_size"
      height="~side_button_size"
      color="hover(transparent)"
      hover_color="hover"
      tooltip="${tooltip}"
      tooltip_side="${tooltip_side}"
    >
      <sprite src_builtin="${src_builtin}" width="~side_sprite_size" height="~side_sprite_size" />
    </Button>
  </template>

  <template name="BarButton">
    <Button id="${id}" round="10" width="36" height="36" color="hover(transparent)" hover_color="hover" tooltip="${tooltip}" tooltip_side="top">
      <sprite src_builtin="${src_builtin}" width="18" height="18" />
    </Button>
  </template>

  <elements>
    <div width="100%" height="100%" padding="4" interactable="0">
      <!-- LVRR: oneDesign window, a sidebar and an inset content card; the desktop window resizes from its edges -->
      <rectangle
        id="rect_window"
        flex_direction="row"
        width="100%"
        height="100%"
        round="18"
        color="sidebar"
        border="1"
        border_color="stroke"
        overflow_x="scroll"
      >
        <!-- LEFT MENU -->
        <div id="menu"
          width="~side_size"
          min_width="~side_size"
          max_width="~side_size"
          height="100%"
          flex_direction="column"
          align_items="center"
          padding_top="8"
          padding_bottom="8"
          gap="4">
          <SideButton id="btn_side_home" src_builtin="@/dashboard/wayvr_dashboard_mono.svg" tooltip="HOME_SCREEN" tooltip_side="right" />
          <!-- LVRR: VR library, running apps, headset and PC; Games and Monado open from those pages -->
          <SideButton id="btn_side_library" src_builtin="@/dashboard/games.svg" tooltip="LVRR.LIBRARY.TITLE" tooltip_side="right" />
          <SideButton id="btn_side_apps" src_builtin="@/dashboard/apps.svg" tooltip="APPLICATIONS" tooltip_side="right" />
          <SideButton id="btn_side_running" src_builtin="@/dashboard/play.svg" tooltip="LVRR.RUNNING.TITLE" tooltip_side="right" />
          <SideButton id="btn_side_headset" src_builtin="@/dashboard/wivrn_head_symbolic.svg" tooltip="LVRR.HEADSET.TITLE" tooltip_side="right" />
          <SideButton id="btn_side_pc" src_builtin="@/dashboard/display.svg" tooltip="LVRR.PC.TITLE" tooltip_side="right" />
          <div display="none">
            <SideButton id="btn_side_games" src_builtin="@/dashboard/games.svg" tooltip="GAMES" tooltip_side="right" />
            <SideButton id="btn_side_monado" src_builtin="@/dashboard/monado.svg" tooltip="MONADO_RUNTIME" tooltip_side="right" />
          </div>
          <div flex_grow="1" />
          <rectangle id="side_separator" height="1" color="stroke" width="24" margin_bottom="4" />
          <SideButton id="btn_side_settings" src_builtin="@/dashboard/settings.svg" tooltip="SETTINGS" tooltip_side="right" />
        </div>

        <div
          flex_direction="column"
          gap="6"
          flex_grow="1"
          height="100%"
          padding_top="6"
          padding_right="6"
          padding_bottom="6"
          overflow_x="scroll">
          <!-- CONTENT -->
          <!-- color alpha will be modified at runtime -->
          <rectangle
            id="rect_content"
            color="canvas"
            border="1"
            border_color="stroke"
            round="14"
            flex_grow="1"
            width="100%"
            flex_direction="column"
            overflow="scroll"
            position="relative"
          >
            <!-- HEADERBAR -->
            <div position="relative" width="100%" height="~top_size" min_height="~top_size" max_height="~top_size" align_items="center" justify_content="center">
              <!-- LVRR: the desktop window lets presses on the title move it -->
              <rectangle id="titlebar" min_width="300" height="100%" consume_mouse_events="1" color="#00000000" align_items="center" justify_content="center" gap="8">
                <sprite id="sprite_titlebar_icon" width="18" height="18" color="text2" />
                <label id="label_titlebar_title" weight="bold" size="15" text="Title" color="text" />
              </rectangle>
              <!-- Close button -->
              <div position="absolute" width="100%" height="100%" padding_right="11" align_items="center" justify_content="end" interactable="0">
                <Button id="btn_close" round="100%" width="28" height="28" tooltip="CLOSE_WINDOW" tooltip_side="left"
                  hover_color="danger">
                  <sprite src_builtin="@/dashboard/close.svg" width="16" height="16" />
                </Button>
              </div>
            </div>

            <div overflow_x="scroll" overflow_y="scroll" width="100%" flex_grow="1">
              <div
                id="content"
                flex_direction="column"
                gap="8"
                width="100%"
                height="100%"
              >
                <!-- padding set at runtime -->
                <!-- filled-in at runtime -->
              </div>
            </div>
            <div position="absolute" id="popup_manager" width="100%" height="100%" />
          </rectangle>
          <!-- BOTTOM PANEL -->
          <rectangle
            id="bottom_bar"
            consume_mouse_events="1"
            width="100%"
            height="48"
            min_height="48"
            max_height="48"
            box_sizing="border_box"
            round="14"
            border="1"
            border_color="stroke"
            flex_direction="row"
            align_items="center"
            justify_content="space_between"
            padding_left="6"
            padding_right="16"
            color="surface"
          >
            <div gap="2" align_items="center">
              <BarButton id="btn_power" src_builtin="@/dashboard/power.svg" tooltip="POWER_OPTIONS.TITLE" />
              <BarButton id="btn_audio" src_builtin="@/dashboard/volume.svg" tooltip="AUDIO.VOLUME" />
              <BarButton id="btn_recenter" src_builtin="@/dashboard/recenter.svg" tooltip="ACTIONS.RECENTER_PLAYSPACE" />
            </div>
            <label id="label_time" weight="semibold" size="14" color="text" />
          </rectangle>
        </div>
      </rectangle>
    </div>
  </elements>
</layout>
