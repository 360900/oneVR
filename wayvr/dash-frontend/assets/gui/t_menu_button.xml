<layout version="2">
  <macro name="home_button" round="14" color="surface_alt" hover_color="fill_strong" />

  <template name="MenuButton">
    <Button
      id="${id}"
      width="120"
      height="82"
      macro="home_button">
      <div gap="8"
        align_items="center"
        justify_content="center"
        flex_direction="column">
        <sprite src_builtin="${icon}" width="28" height="28" />
        <label weight="semibold" size="15" text="${text}" translation="${translation}" />
      </div>
    </Button>
  </template>
</layout>
