<layout version="2">
  <elements>
    <rectangle
      consume_mouse_events="1"
      id="root"
      new_pass="1"
      width="100%"
      height="100%"
      flex_direction="column"
      position="absolute"
      color="canvas"
      round="14"
    >
      <!-- Headerbar -->
      <div position="relative" width="100%" height="50" flex_shrink="0" flex_direction="column">
        <div gap="8" align_items="center" id="top_bar_contents" height="49" padding_left="7">
          <!-- Back button -->
          <Button id="but_back" width="36" height="36" round="10" color="hover(transparent)" hover_color="hover">
            <sprite src_builtin="@/dashboard/back.svg" width="16" height="16" />
          </Button>

          <!-- Title -->
          <label id="popup_title" color="text" weight="bold" size="15" />
        </div>
        <rectangle width="100%" height="1" color="stroke" />
      </div>

      <div
        width="100%"
        height="100%"
        position="relative"
      >
        <div id="content" width="100%" height="100%" position="absolute" overflow_y="scroll">
          <!-- Padding set at runtime -->
          <!-- Content, filled-in at runtime -->
        </div>      
      </div>
    </rectangle>
  </elements>
</layout>
