<layout version="2">
  <macro name="group_box"
    flex_direction="column"
    align_items="baseline"
    border="1"
    color="surface"
    border_color="stroke"
    shadow="1"
    padding="14"
    gap="8"
    round="14"/>
  
  <!-- id -->
  <template name="GroupBox">
    <rectangle macro="group_box" id="rect">
      <CHILDREN/>
    </rectangle>
  </template>

  <!-- src_builtin, text, translation -->
  <template name="GroupBoxTitle">
    <div flex_direction="row" align_items="center" gap="8" margin_bottom="4">
      <sprite src_builtin="${src_builtin}" width="18" height="18" color="text2" />
      <label text="${text}" translation="${translation}" weight="bold" size="15" color="text" />
    </div>
  </template>
</layout>
