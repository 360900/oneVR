<layout version="2">
  <elements>
    <div interactable="0">
      <rectangle
        max_width="800"
        padding="16"
        flex_direction="column"
        gap="8"
        color="glass" border_color="stroke" border="1" round="18">

        <div flex_direction="column" padding="8" justify_content="space_evenly">
          <label wrap="1" color="accent_text" weight="bold" size="20" padding_left="16" padding_right="16" translation="ALTTAB.RELEASE_TO_FOCUS" />

          <!-- A simple separator -->
          <rectangle width="100%" height="1" color="stroke" margin="16" />

          <div gap="8" flex_direction="row" >
            <div width="50%" gap="8" flex_direction="column" >
              <div width="100%">
                <label translation="ALTTAB.WHILE_AIMING" color="text" weight="bold" size="24" padding_left="16" padding_right="16" />
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="W" color="accent_text" weight="semibold" size="20" padding_left="16" padding_right="8" />
                </div>
                <div flex_direction="row" wrap="1">
                  <label translation="ALTTAB.CLICK" color="text" wrap="1" size="20" padding_left="8" />
                  <label text="*" color="text3" wrap="1" size="20" padding_left="4" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="A" color="accent_text" weight="semibold" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.GRABALL" color="text" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="Q" color="accent_text" weight="semibold" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.GRAB" color="text" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="D" color="accent_text" weight="semibold" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.DASH" color="text" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="E" color="accent_text" weight="semibold" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.EDIT" color="text" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="T" color="accent_text" weight="semibold" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.KEYBOARD" color="text" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="R" color="accent_text" weight="semibold" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.RECENTER" color="text" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="1~4" color="accent_text" weight="semibold" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.SET" color="text" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
            </div>
            <div width="50%" gap="8" flex_direction="column" >
              <div width="100%">
                <label translation="ALTTAB.GENERAL_BINDS" color="text" weight="bold" size="24" padding_left="16" padding_right="16" />
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="Super+Z" color="accent_text" weight="semibold" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.TOGGLE_CAPTURE" color="text" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="Super+X" color="accent_text" weight="semibold" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.FOCUS_MODE" color="text" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <div flex_direction="row" width="100%">
                <div width="90">
                  <label text="Alt+F4" color="accent_text" weight="semibold" size="20" padding_left="16" padding_right="8" />
                </div>
                <div>
                  <label translation="ALTTAB.CLOSE" color="text" wrap="1" size="20" padding_left="8" padding_right="16" />
                </div>
              </div>
              <!-- A simple separator -->
              <rectangle width="100%" height="1" color="stroke" margin="16" padding_right="16" />
              <div width="100%" flex_direction="row">
                  <label text="*" color="text3" wrap="1" size="20" padding_left="8" />
                  <label translation="ALTTAB.MOUSE" color="text" wrap="1" size="20" padding_left="4" padding_right="16" />
              </div>
            </div>
          </div>
        </div>
      </rectangle>
    </div>
  </elements>
</layout>
