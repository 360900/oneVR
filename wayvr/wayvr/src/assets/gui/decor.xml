<layout version="2">
  <macro name="window_button" min_width="40" min_height="40" padding="8" round="10" align_items="center" justify_content="center" color="hover(transparent)" />
  <macro name="window_button_icon" width="24" height="24" />

  <elements>
    <div flex_grow="1" height="48">
      <rectangle
        id="rect"
        flex_grow="1" height="48"
        padding="4" border="1"
        round="14"
        align_items="center"
        justify_content="space_between"
        color="headerbar"
        border_color="stroke"
      >
        <label id="title" text="~title" margin_left="8" color="text" size="20" weight="bold" />
        <div gap="4">
          <Button macro="window_button" _release="::EditToggle">
            <sprite macro="window_button_icon" src="@/watch/edit.svg" />
          </Button>

          <Button macro="window_button" _release="::DecorCloseWindow"
            round="100%" hover_color="danger">
            <sprite macro="window_button_icon" src="@/edit/close.svg" />
          </Button>
        </div>

      </rectangle>
    </div>
  </elements>
</layout>
