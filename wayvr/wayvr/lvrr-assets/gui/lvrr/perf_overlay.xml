<layout version="2">
  <!-- LVRR: the performance overlay, see src/lvrr/perf_overlay.rs -->

  <!-- id, translation -->
  <template name="Stat">
    <div flex_direction="row" justify_content="space_between" gap="24" width="100%">
      <label translation="${translation}" size="18" color="text2" />
      <label id="${id}" text="-" size="18" weight="semibold" color="text" />
    </div>
  </template>

  <elements>
    <rectangle padding="12" flex_direction="column" gap="4" min_width="300" color="glass" border_color="stroke" border="1" round="14">
      <Stat id="refresh_rate" translation="LVRR.PERF.REFRESH_RATE" />
      <Stat id="game_fps" translation="LVRR.PERF.GAME_FPS" />
      <Stat id="game_missed" translation="LVRR.PERF.GAME_MISSED" />
      <Stat id="encoder_skipped" translation="LVRR.PERF.ENCODER_SKIPPED" />
      <Stat id="latency" translation="LVRR.PERF.LATENCY" />
      <Stat id="encode" translation="LVRR.PERF.ENCODE" />
      <Stat id="send" translation="LVRR.PERF.SEND" />
      <Stat id="transfer" translation="LVRR.PERF.TRANSFER" />
      <Stat id="decode" translation="LVRR.PERF.DECODE" />
      <Stat id="display" translation="LVRR.PERF.DISPLAY" />
      <Stat id="network" translation="LVRR.PERF.NETWORK" />
      <Stat id="headset_gpu" translation="LVRR.PERF.HEADSET_GPU" />
    </rectangle>
  </elements>
</layout>
