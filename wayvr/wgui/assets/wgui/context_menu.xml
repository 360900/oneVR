<layout version="2">
  <macro name="ContextMenuCell" tooltip_str="${tooltip_str}" text_weight="normal" border="0" round="6" padding_left="10" padding_right="10" color="hover(transparent)" hover_color="hover" justify_content="start" min_height="32"/>
  
  <!--
    text
  -->
  <template name="CellButton">
    <Button id="button" text="${text}" macro="ContextMenuCell"/>
  </template>

  <!--
    text, sprite_src_builtin
  -->
  <template name="CellButtonSprite">
    <Button id="button" macro="ContextMenuCell" gap="8">
      <sprite src_builtin="${sprite_src_builtin}" width="16" height="16" color="text"/>
      <label text="${text}"/>
    </Button>
  </template>

  <template name="Separator">
    <rectangle width="100%" height="1" color="stroke" margin_top="2" margin_bottom="2" />
  </template>

  <elements>
    <rectangle consume_mouse_events="1" color="float" round="14" border="1" border_color="stroke" shadow="2" gap="0" padding="6" id="buttons" flex_direction="column">

    </rectangle>
  </elements>
</layout>
