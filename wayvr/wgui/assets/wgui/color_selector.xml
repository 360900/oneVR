<layout version="2">
  <!-- slider_id, color -->
  <template name="Cell">
    <div align_items="center" gap="8">
      <!-- color pip -->
      <rectangle width="16" height="16" round="100%" color="${color}" border="1" border_color="stroke"/>
      <Slider id="${slider_id}" min_value="0" max_value="255" width="200" height="24" />
    </div>
  </template>

  <elements>
    <div gap="8" align_items="center">
      <div gap="8" flex_direction="column">
        <Cell slider_id="slider_r" color="#FF0000"/>
        <Cell slider_id="slider_g" color="#00FF00"/>
        <Cell slider_id="slider_b" color="#0000FF"/>
      </div>
      <rectangle id="rect_color" width="96" height="96" border="1" color="#ffffff" border_color="stroke" round="10" />
    </div>
  </elements>
</layout>
